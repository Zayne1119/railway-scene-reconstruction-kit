{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/railway-benchmark-split-manifest-v1.json",
  "type": "object",
  "required": ["schema_version", "split_id", "dataset_id", "protocol_id", "blocks"],
  "properties": {
    "schema_version": {"const": "railway.benchmark.split-manifest.v1"},
    "split_id": {"type": "string", "minLength": 3},
    "dataset_id": {"type": "string", "minLength": 3},
    "protocol_id": {"type": "string", "minLength": 3},
    "created_at": {"type": "string"},
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "evaluation_group_id", "scene_id", "role", "core_start_m", "core_end_m", "context_before_m", "context_after_m"],
        "properties": {
          "block_id": {"type": "string", "minLength": 3},
          "evaluation_group_id": {"type": "string", "minLength": 3},
          "scene_id": {"type": "string", "minLength": 2},
          "role": {"enum": ["development", "calibration", "validation", "test"]},
          "core_start_m": {"type": "number"},
          "core_end_m": {"type": "number"},
          "context_before_m": {"type": "number", "minimum": 0},
          "context_after_m": {"type": "number", "minimum": 0},
          "complexity_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
