{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/railway-benchmark-dataset-manifest-v1.json",
  "type": "object",
  "required": ["schema_version", "dataset_id", "role", "scenes"],
  "properties": {
    "schema_version": {"const": "railway.benchmark.dataset-manifest.v1"},
    "dataset_id": {"type": "string", "minLength": 3},
    "role": {"enum": ["development_case_study", "prospective_blind_test", "external_test"]},
    "created_at": {"type": "string"},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "site_id", "split_role", "chainage_range_m", "coordinate_reference", "inputs", "limitations"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 2},
          "site_id": {"type": "string", "minLength": 2},
          "split_role": {"enum": ["development", "calibration", "validation", "test"]},
          "chainage_range_m": {
            "type": "array",
            "prefixItems": [{"type": "number"}, {"type": "number"}],
            "minItems": 2,
            "maxItems": 2
          },
          "coordinate_reference": {
            "type": "object",
            "required": ["units", "axis", "epsg", "vertical_datum"],
            "properties": {
              "units": {"const": "metre"},
              "axis": {"const": "Z-up"},
              "epsg": {"type": ["integer", "null"]},
              "vertical_datum": {"type": ["string", "null"]},
              "control_points": {"type": ["string", "null"]},
              "independent_check_points": {"type": ["string", "null"]}
            },
            "additionalProperties": true
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "kind", "path"],
              "properties": {
                "id": {"type": "string", "minLength": 2},
                "kind": {"enum": ["point_cloud", "camera_poses", "panorama_archive", "panorama_directory", "survey", "asset_ledger", "derived_evaluation_points", "other"]},
                "path": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "bytes": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                "metadata": {"type": "object"}
              },
              "additionalProperties": false
            }
          },
          "limitations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
