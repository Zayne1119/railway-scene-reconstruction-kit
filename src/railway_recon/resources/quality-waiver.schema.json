{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/railway-quality-waiver-v2.json",
  "type": "object",
  "required": [
    "schema_version",
    "waiver_id",
    "check_id",
    "artifact_sha256",
    "reason",
    "risk",
    "mitigation",
    "approved_by",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "railway.quality-waiver.v2"},
    "waiver_id": {"type": "string", "minLength": 3},
    "check_id": {"type": "string", "minLength": 3},
    "artifact_sha256": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
    },
    "reason": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "minLength": 1},
    "mitigation": {"type": "string", "minLength": 1},
    "approved_by": {"type": "array", "minItems": 2},
    "expires_at": {"type": "string"}
  },
  "additionalProperties": true
}
