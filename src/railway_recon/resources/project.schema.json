{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/railway-project-v1.json",
  "type": "object",
  "required": ["schema_version", "project", "inputs", "workspace", "segmentation", "reconstruction", "quality", "algorithms", "rules"],
  "properties": {
    "schema_version": {"const": "railway.toolkit.project.v1"},
    "project": {
      "type": "object",
      "required": ["id", "name", "units", "axis", "crs"],
      "properties": {
        "id": {"type": "string", "minLength": 3, "maxLength": 64},
        "name": {"type": "string", "minLength": 1},
        "confidentiality": {"enum": ["internal", "restricted", "public_synthetic"]},
        "units": {"const": "metre"},
        "axis": {"const": "Z-up"},
        "crs": {
          "type": "object",
          "required": ["epsg", "vertical_datum"],
          "properties": {
            "epsg": {"type": ["integer", "null"]},
            "vertical_datum": {"type": ["string", "null"]},
            "control_points": {"type": ["string", "null"]},
            "independent_check_points": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "required": ["camera_csv"],
      "oneOf": [
        {
          "required": ["point_cloud"],
          "not": {"required": ["point_clouds"]}
        },
        {
          "required": ["point_clouds"],
          "not": {"required": ["point_cloud"]}
        }
      ],
      "properties": {
        "point_cloud": {"type": "string"},
        "point_clouds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
              "path": {"type": "string", "minLength": 1},
              "priority": {"type": "integer"}
            },
            "additionalProperties": false
          }
        },
        "camera_csv": {"type": "string"},
        "panorama_root": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "required": ["manifests", "segment_manifest", "segments", "derived", "asset_registry", "reports", "exports"],
      "properties": {
        "input_source_manifest": {"type": "string"},
        "filtered_camera_csv": {"type": "string"}
      },
      "additionalProperties": {"type": "string"}
    },
    "segmentation": {
      "type": "object",
      "required": ["length_m", "corridor_half_width_m", "z_below_camera_m", "z_above_camera_m", "chunk_size_points"],
      "properties": {
        "length_m": {"type": "number", "exclusiveMinimum": 0},
        "corridor_half_width_m": {"type": "number", "exclusiveMinimum": 0},
        "z_below_camera_m": {"type": "number", "minimum": 0},
        "z_above_camera_m": {"type": "number", "minimum": 0},
        "chunk_size_points": {"type": "integer", "minimum": 1000},
        "adaptive_length_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_m", "end_m", "length_m"],
            "properties": {
              "start_m": {"type": "number", "minimum": 0},
              "end_m": {"type": "number", "exclusiveMinimum": 0},
              "length_m": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reconstruction": {"type": "object"},
    "quality": {"type": "object"},
    "algorithms": {
      "type": "object",
      "required": ["rail_detection", "linear_detection", "track_build", "projection_calibration"],
      "properties": {
        "rail_detection": {"type": "string"},
        "linear_detection": {"type": "string"},
        "vertical_hypotheses": {"type": "string"},
        "canopy_structure": {"type": "string"},
        "canopy_photo_evidence": {"type": "string"},
        "platform_surface": {"type": "string"},
        "platform_photo_evidence": {"type": "string"},
        "platform_mesh": {"type": "string"},
        "platform_interface_audit": {"type": "string"},
        "targeted_canopy_recovery": {"type": "string"},
        "vertical_conflict_photo_evidence": {"type": "string"},
        "track_build": {"type": "string"},
        "track_graph": {"type": "string"},
        "projection_calibration": {"type": "string"}
      },
      "additionalProperties": true
    },
    "rules": {"type": "string"}
  },
  "additionalProperties": false
}
